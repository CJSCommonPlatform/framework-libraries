  "type": "object",
  "properties": {
    "nino": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "home_address": {
      "$ref": "http://justice.gov.uk/standards/address.json"
    },
    "correspondence_address": {
      "$ref": "http://justice.gov.uk/standards/complex_address.json#/definitions/complex_address"
    }
  },
  "required": [
